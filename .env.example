# Local AI Studio configuration
PORT=8788
LOCAL_STUDIO_BASE_URL=https://api.newportai.com
LOCAL_STUDIO_DEPLOYMENT_MODE=local
LOCAL_STUDIO_MOCK=false
MAX_TASK_CREDITS=1000

# Development only. Prefer entering the key in the UI.
# LOCAL_STUDIO_API_KEY=sk-your-key

# Shared cost display for every batch and card. Credits remain the stored source.
LOCAL_STUDIO_COST_UNIT=credits
# Set both values to display all costs as USD later:
# LOCAL_STUDIO_COST_UNIT=usd
# LOCAL_STUDIO_USD_PER_CREDIT=<your-account-rate>
